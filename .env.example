# Bu namuna fayl — git'ga commit qilinadi.
# HAQIQIY kalitlarni bu yerga YOZMANG, ular `.env` faylida saqlanadi.

# Ma'lumotlar bazasi
# Lokal (docker compose up -d):
DATABASE_URL="postgresql://samara:samara@localhost:5432/samara?schema=public"
# Neon yoki VPS uchun shu qatorni almashtiring, boshqa hech narsa o'zgarmaydi.

# Sessiya cookie'sini imzolash uchun maxfiy kalit.
# Yangi kalit yaratish: openssl rand -base64 32
SESSION_SECRET=""

# Gemini API kaliti (4-bosqichda kerak bo'ladi)
GEMINI_API_KEY=""
