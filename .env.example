# Bu namuna fayl — git'ga commit qilinadi.
# HAQIQIY kalitlarni bu yerga YOZMANG, ular `.env` faylida saqlanadi
# (`.env` gitignore'da), production'da esa Vercel Environment Variables'da.

# ── Ma'lumotlar bazasi ───────────────────────────────────────────────
# Lokal ishlash (docker compose up -d):
DATABASE_URL="postgresql://samara:samara@localhost:5432/samara?schema=public"

# Neon (production). Ikkita manzil kerak:
#   DATABASE_URL         — POOLED (host nomida "-pooler" bor), ish vaqti uchun
#   DIRECT_DATABASE_URL  — to'g'ridan-to'g'ri, faqat migratsiya uchun
# Sabab: pgbouncer tranzaksiya rejimida migratsiya (DDL) ishlamaydi.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/samara?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/samara?sslmode=require"

# ── Sessiya ──────────────────────────────────────────────────────────
# Kamida 32 belgi. Yangi kalit: openssl rand -base64 32
# Production uchun ALOHIDA kalit yarating, lokalnikini ishlatmang.
SESSION_SECRET=""

# ── AI ───────────────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
# Bo'sh qoldirilsa ilova ishlaydi, faqat AI izohlari o'rniga xabar chiqadi.
GEMINI_API_KEY=""
