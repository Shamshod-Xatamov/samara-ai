# Bu namuna fayl — git'ga commit qilinadi.
# HAQIQIY kalitlarni bu yerga YOZMANG. Ular:
#   - lokal ishlash uchun  → `.env` faylida (gitignore'da)
#   - production uchun     → Vercel Environment Variables'da

# ── Ma'lumotlar bazasi ───────────────────────────────────────────────
# Lokal ishlash (docker compose up -d):
DATABASE_URL="postgresql://samara:samara@localhost:5432/samara?schema=public"

# Neon (production) uchun ikkita manzil kerak:
#   DATABASE_URL         — POOLED (host nomida "-pooler" bor), ish vaqti uchun
#   DIRECT_DATABASE_URL  — to'g'ridan-to'g'ri, faqat migratsiya uchun
# Sabab: pgbouncer tranzaksiya rejimida migratsiya (DDL) ishlamaydi.
# Bu qiymatlar Vercel'da saqlanadi, bu faylda emas.

# ── Sessiya ──────────────────────────────────────────────────────────
# Kamida 32 belgi. Yangi kalit: openssl rand -base64 32
SESSION_SECRET=""

# ── AI ───────────────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
# Bo'sh qoldirilsa ilova ishlaydi, faqat AI izohlari o'rniga xabar chiqadi.
GEMINI_API_KEY=""
